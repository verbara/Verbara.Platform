<?xml version="1.0" encoding="utf-8"?>
<!--
  Coverage collection settings for the CI coverage-ratchet job.
  Measures only real src/ production code: excludes test assemblies, generated
  code (System.Text.Json source-gen carries [GeneratedCode]) and SQL migrations.
  See docs/specs/2026-06-14-coverage-ratchet-pilot.md.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <Exclude>[*.Tests]*,[*.Tests.*]*</Exclude>
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
