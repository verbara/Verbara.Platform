<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- <clear /> stops user-level / system NuGet.Config sources from leaking into
         this build (e.g. internal feeds with credentials). Matches the convention
         already used by Verbara.Sdk.Pro and avoids NU1507 when central package
         management is on. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- GitHub Packages NuGet feed for private Verbara.Sdk.Pro.* packages.
         Credentials are injected at restore time via `dotnet nuget update source github`
         (NOT via a static packageSourceCredentials block, because env-var
         substitution %VAR% is unreliable on .NET 5+/.NET Core; only works on
         .NET Framework Windows). For CI the workflow's docker/build-push-action
         passes GITHUB_TOKEN via BuildKit secret `nuget_auth_token`; the Dockerfile
         then calls `dotnet nuget update source github` with the username + token
         (store-password-in-clear-text flag) before restore. For local Docker builds
         the maintainer sources GITHUB_PACKAGES_PAT from ~/.verbara/secrets.env and
         passes it the same way. For local dotnet CLI dev (no Docker) run
         `dotnet nuget update source github` once per machine using the same flag;
         auth then persists. See
         Verbara.Sdk.Pro/docs/operations/2026-05-10-pro-packages-to-github-packages.md. -->
    <add key="github" value="https://nuget.pkg.github.com/verbara/index.json" protocolVersion="3" />
    <!-- Local feed for fast iteration against an UNPUBLISHED Verbara.Sdk* /
         Verbara.Sdk.Pro* build. The directory is repo-relative and is committed
         EMPTY on purpose (`.local-feed/.gitkeep`, with `*.nupkg` / `*.snupkg`
         gitignored): NU1301 ("the local source doesn't exist") is FATAL under
         TreatWarningsAsErrors and fires on a MISSING directory — never on an
         empty one, which restores clean and simply falls through to the other
         sources. A machine-only absolute/parent path here would therefore break
         every restore off the maintainer's machine (that is exactly how
         Verbara.Sdk.Pro's Dependabot NuGet updater came to discover 0 projects
         and still report the run green). To iterate on an unpublished build, run
         `dotnet pack -c Release -o <this-repo>/.local-feed/` from the Verbara.Sdk
         or Verbara.Sdk.Pro repo, then restore here. -->
    <add key="local" value="./.local-feed/" />
  </packageSources>
  <!-- Central Package Management (Directory.Packages.props) requires explicit
       source mapping when multiple sources are defined (NU1507). Map private
       Verbara.Sdk.Pro.* packages exclusively to the `github` source; everything
       else goes to `nuget.org`. The `local` source IS mapped — to both
       `Verbara.Sdk.Pro*` and `Verbara.Sdk.*` (see below) — so it is actively
       probed on every restore that does not remove it first, which is why its
       directory must exist in a fresh checkout. CI and the Dockerfiles still
       run `dotnet nuget remove source local` before restore (defensive; a
       Docker build context need not carry the directory). -->
  <packageSourceMapping>
    <packageSource key="github">
      <package pattern="Verbara.Sdk.Pro*" />
    </packageSource>
    <!-- Local feed also mapped for Verbara.Sdk.Pro* AND Verbara.Sdk.* so the
         maintainer can iterate on SDK/Pro changes before publishing. Dockerfile
         removes the `local` source before restore, so in a production/Docker build
         the non-Pro Verbara.Sdk.* packages (MIT, published to nuget.org from 2.2.0
         onward — ADR-0022 Phase D) resolve via the nuget.org `*` mapping below,
         while Verbara.Sdk.Pro.* resolve from `github`. -->
    <packageSource key="local">
      <package pattern="Verbara.Sdk.Pro*" />
      <package pattern="Verbara.Sdk.*" />
    </packageSource>
    <!-- Non-Pro Verbara.Sdk.* are published to nuget.org (from 2.2.0 — ADR-0022
         Phase D). They MUST be listed here explicitly: PackageSourceMapping uses
         longest-prefix-wins, so the `Verbara.Sdk.*` pattern (mapped to `local`)
         shadows the `*` catch-all. Without this entry, once the Dockerfile removes
         the `local` source the SDK packages resolve to NO source (NU1100). The even
         longer `Verbara.Sdk.Pro*` pattern still routes Pro to `github`. -->
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Verbara.Sdk.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
