<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <NoWarn>$(NoWarn);CS1591;NU1902;NU1603</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Verbara Contributors</Authors>
    <Company>Verbara</Company>
    <Product>Verbara.Platform</Product>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/verbara/verbara-platform</RepositoryUrl>
    <PackageTags>verbara;platform;contact-center;omnichannel;native-aot</PackageTags>
    <PackageVersion>2.6.0</PackageVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('src'))">
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('tests'))">
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <!-- ADR-0022 — Dapper is PERMANENTLY BANNED ecosystem-wide. It relies on
       DynamicMethod + MakeGenericType (runtime IL emit) and blocks Native AOT, which every
       shippable Verbara image MUST use so closed-source Pro IP never ships as decompilable
       IL ("la imagen siempre debe ser AOT"). Use Verbara.Sdk.Data.Npgsql (NpgsqlExecutor
       facade + reflection-free NpgsqlDataReader getters) instead. This guard fails the build
       if Dapper / Dapper.AOT / Verbara.Sdk.Dapper.Stubs is ever (re)introduced. -->
  <Target Name="BanDapperPackageReferences" BeforeTargets="CollectPackageReferences;BeforeCompile">
    <ItemGroup>
      <_BannedDapperRef Include="@(PackageReference)"
                        Condition="$([System.String]::Copy('%(PackageReference.Identity)').StartsWith('Dapper')) Or '%(PackageReference.Identity)' == 'Verbara.Sdk.Dapper.Stubs'" />
    </ItemGroup>
    <Error Condition="'@(_BannedDapperRef)' != ''"
           Text="ADR-0022: '@(_BannedDapperRef)' is a BANNED package — Dapper blocks Native AOT. Remove it from $(MSBuildProjectName) and use Verbara.Sdk.Data.Npgsql instead." />
  </Target>

  <!-- ADR-0023 — the non-AOT microservices (Realtime/Renderer/Mail) ship as decompilable
       IL because their dependencies (SignalR server dispatch, QuestPDF/ScottPlot, MailKit/
       Graph) can't be Native AOT. They MUST NOT carry crown-jewel Pro IP, so the only Pro
       code that ever ships as IL is non-crown-jewel plumbing. This guard fails the build if
       a crown-jewel Pro package is referenced by these microservices — keep that logic in
       the AOT API instead. See docs/decisions/0023-publishing-non-aot-microservices.md. -->
  <Target Name="BanCrownJewelProInNonAotMicroservices"
          Condition="'$(MSBuildProjectName)' == 'Verbara.Platform.Realtime' Or '$(MSBuildProjectName)' == 'Verbara.Platform.Renderer' Or '$(MSBuildProjectName)' == 'Verbara.Platform.Mail'"
          BeforeTargets="CollectPackageReferences;BeforeCompile">
    <ItemGroup>
      <_CrownJewelPro Include="@(PackageReference)" Condition="
        $([System.String]::Copy('%(PackageReference.Identity)').StartsWith('Verbara.Sdk.Pro.Dialer')) Or
        $([System.String]::Copy('%(PackageReference.Identity)').StartsWith('Verbara.Sdk.Pro.Analytics')) Or
        $([System.String]::Copy('%(PackageReference.Identity)').StartsWith('Verbara.Sdk.Pro.CallAnalytics')) Or
        $([System.String]::Copy('%(PackageReference.Identity)').StartsWith('Verbara.Sdk.Pro.AgentAssist')) Or
        $([System.String]::Copy('%(PackageReference.Identity)').StartsWith('Verbara.Sdk.Pro.EventStore')) Or
        $([System.String]::Copy('%(PackageReference.Identity)').StartsWith('Verbara.Sdk.Pro.Routing'))" />
    </ItemGroup>
    <Error Condition="'@(_CrownJewelPro)' != ''"
           Text="ADR-0023: '@(_CrownJewelPro)' is a crown-jewel Pro package and MUST NOT ship as decompilable IL in the non-AOT microservice $(MSBuildProjectName). Keep that logic in the AOT Verbara.Platform.Api." />
  </Target>

</Project>
