<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\Verbara.Platform.Storage.Postgres\Verbara.Platform.Storage.Postgres.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="coverlet.collector" />
    <!-- R5.2 PC.3 — Testcontainers Postgres for RoleTemplateSeeder.ReseedExistingTenantsAsync coverage. -->
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Verbara.Sdk.Data.Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <!-- live-postgres-ci-lane grounding: ~13 fixture classes each start their own
         Testcontainers Postgres container. xUnit parallelizes test collections
         (one per class) by default, so all containers start concurrently — under
         host contention (constrained CI runners, or a busy shared dev box) this
         intermittently surfaces as Npgsql "Connection reset by peer" during the
         post-pg_isready SSL handshake, a container-startup race rather than a
         test-logic bug. Serializing collections bounds concurrent container starts
         at the cost of wall-clock time; see design.md's Grounding-resolution note. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
