<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Unit + integration tests for Verbara.Platform.Realtime (the SignalR Hub microservice extracted from Verbara.Platform.Api per ADR-0022 Phase A).</Description>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <NoWarn>$(NoWarn);IL2026;IL3050;AD0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Verbara.Platform.Realtime\Verbara.Platform.Realtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="System.Reactive" />
    <!-- In-process hub round-trips for the account-status enforcement tests. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <!-- Drives the hub filter's token-expiry abort deterministically. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <!-- RealtimeHostCompositionTests boots the real Realtime Program (WebApplicationFactory)
         against a Testcontainers Postgres: the host runs its cluster-lock migration at startup. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

</Project>
