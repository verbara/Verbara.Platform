<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Verbara.Platform.Benchmarks (AHH Phase 0)

    OPT-IN micro-benchmark project. NOT included in Verbara.Platform.slnx —
    runs exclusively via scripts/profiling/run-benchmarks.sh and produces the
    evidence artifacts referenced by docs/research/2026-04-XX-auth-hotpath-baseline.md.

    Driven by BenchmarkDotNet on JIT (BenchmarkDotNet itself emits IL at
    runtime and is incompatible with PublishAot; benches measure source code
    on JIT, then Phase 0 separately validates AOT compatibility via
    tests/Verbara.Platform.Api.Aot.Probe).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Verbara.Platform.Benchmarks</RootNamespace>
    <AssemblyName>Verbara.Platform.Benchmarks</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Override Directory.Build.props tests/ defaults: this is a runnable
         console app, NOT an xunit IsTestProject. -->
    <IsTestProject>false</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- BenchmarkDotNet emits IL at runtime; AOT analyzer cannot apply. -->
    <IsAotCompatible>false</IsAotCompatible>
    <!-- Directory.Build.props turns the trim and AOT analyzers on everywhere. This JIT-only console binds a few internal
         Api members once per GlobalSetup by reflection (contact-history-opens-by-assignment task 3.6), which those
         analyzers flag; nothing here is ever trimmed or published AOT. -->
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
  </PropertyGroup>

  <!-- conversations-close-after-inactivity task 2.9: the claim-cost negative control (ClaimCostControlStore.cs).
       Read from the environment (MSBuild exposes it as a property) because BenchmarkDotNet rebuilds this project
       in a child build that never sees a -p on the command line. -->
  <PropertyGroup Condition="'$(CLAIM_COST_CONTROL)' == 'true'">
    <DefineConstants>$(DefineConstants);CLAIM_COST_CONTROL</DefineConstants>
  </PropertyGroup>

  <!-- contact-history-opens-by-assignment task 3.6, the T-1 control (AudienceCostControlStore.cs), read from the
       environment for the same reason as CLAIM_COST_CONTROL above. -->
  <PropertyGroup Condition="'$(AUDIENCE_COST_CONTROL)' == 'true'">
    <DefineConstants>$(DefineConstants);AUDIENCE_COST_CONTROL</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="Isopoh.Cryptography.Argon2" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
  </ItemGroup>

  <!-- ConversationClaimCostBench (conversations-close-after-inactivity task 2.9): the real stores and services. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Verbara.Platform.Core\Verbara.Platform.Core.csproj" />
    <ProjectReference Include="..\..\src\Verbara.Platform.Conversations\Verbara.Platform.Conversations.csproj" />
    <ProjectReference Include="..\..\src\Verbara.Platform.Channels.Core\Verbara.Platform.Channels.Core.csproj" />
    <ProjectReference Include="..\..\src\Verbara.Platform.Switchboard\Verbara.Platform.Switchboard.csproj" />
    <ProjectReference Include="..\..\src\Verbara.Platform.Storage.Postgres\Verbara.Platform.Storage.Postgres.csproj" />
    <!-- contact-history-opens-by-assignment task 3.6: T-1's InboundPublish (WebhookInboundProcessor) and T-2/T-3's
         delivery predicate and audience read live in the Api. -->
    <ProjectReference Include="..\..\src\Verbara.Platform.Api\Verbara.Platform.Api.csproj" />
  </ItemGroup>

</Project>
