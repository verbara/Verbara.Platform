<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Integration tests for Verbara.Platform.Api using WebApplicationFactory</Description>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <!-- AD0001 = Roslyn analyzer crashed (RouteHandlerAnalyzer flaky on this assembly's
         WebApplicationFactory route topology). Not a semantic issue with our code. -->
    <NoWarn>$(NoWarn);IL2026;IL3050;AD0001</NoWarn>
    <!-- ADR-0022 Phase D: the IsReflectionEnabledByDefault feature switch is baked into
         the ENTRY assembly's runtimeconfig — i.e. the test host. We deliberately leave
         reflection ENABLED in the test process: the test HttpClient serializes request
         bodies (including anonymous types) with System.Net.Http.Json's no-options
         overloads, which legitimately need reflection and have no source-gen equivalent.
         Set AOT_JSON_STRICT=true to flip the switch off for a gap-surfacing sweep — the
         server-under-test (WebApplicationFactory) then runs with the same
         no-reflection-fallback contract as the Native AOT image, turning any DTO missing
         from ApiJsonContext into a loud NotSupportedException. (The Api project itself
         hard-sets the switch off so the published host + `dotnet run` always behave like
         AOT.) -->
    <JsonSerializerIsReflectionEnabledByDefault Condition="'$(AOT_JSON_STRICT)' == 'true'">false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Verbara.Platform.Api\Verbara.Platform.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- ComposedDataSourceNamesTests boots the real Api Program against a Testcontainers Postgres: the
         host runs the Platform migrations and the cluster-lock schema at startup. -->
    <PackageReference Include="Testcontainers" />
  </ItemGroup>

  <ItemGroup>
    <!-- licensed-agent-metering slice 3: the frozen wire shapes of the peaks report and the export, copied
         verbatim from the change's cross-repo contract (impact.yaml fixtures) for the contract tests. -->
    <None Include="LicensedAgentMetering/Fixtures/*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- partner-channel-pilot-fixes: the frozen refusal bodies (rate-card currency, plan ceiling, dunning on a
         Partner's Customer), copied verbatim from the change's cross-repo contract fixtures. -->
    <None Include="PartnerChannel/Fixtures/*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- supervisor-silent-listen: the frozen wire shapes of the silent-listen routes, the listen phone and the
         extended active-session list, copied verbatim from the change's cross-repo contract fixtures. -->
    <None Include="SupervisorListen/Fixtures/*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- outbound-calls-reach-the-trunk: the frozen dial and voice-transfer bodies (200 and 409 trunk-not-dialable),
         copied verbatim from the change's cross-repo contract fixtures. -->
    <None Include="OutboundTrunk/Fixtures/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

</Project>
