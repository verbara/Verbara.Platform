<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Verbara.Platform.LoadTests (R5.4 S5.1)

    OPT-IN load testing project. NOT included in Verbara.Platform.slnx —
    runs exclusively via scripts/load-test.sh against a docker-compose
    stack stood up by docker/docker-compose.loadtest.yml.

    Driven by NBomber 6.x (https://nbomber.com). Reports written to
    ./load-test-reports/<timestamp>/ as Markdown + CSV + HTML.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Verbara.Platform.LoadTests</RootNamespace>
    <AssemblyName>Verbara.Platform.LoadTests</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Override Directory.Build.props tests/ defaults: this is a runnable
         console app, NOT an xunit IsTestProject. -->
    <IsTestProject>false</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- NBomber 6.x targets netstandard2.1 + brings F# core; keep AOT off. -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NBomber" />
    <PackageReference Include="NBomber.Http" />
  </ItemGroup>

</Project>
