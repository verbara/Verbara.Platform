<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="System.Reactive" Version="6.1.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Verbara.Sdk.Data.Npgsql" Version="2.4.0" />
    <PackageVersion Include="Verbara.Sdk.Cluster.Primitives" Version="2.4.0" />
    <PackageVersion Include="Verbara.Sdk.Cluster.Postgres" Version="2.4.0" />
  </ItemGroup>

  <!-- DataProtection consumed by Verbara.Platform.Identity (ADR-0003 + ADR-0022
       Phase B/D). Raw-Npgsql IXmlRepository replaces the EF Core stack so the
       Platform.Api host can publish Native AOT. Versions match the .NET 10 SDK
       band. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="10.0.7" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.Extensions" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="AWSSDK.S3" Version="4.0.102.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Verbara.Sdk.Hosting" Version="2.4.0" />
    <PackageVersion Include="Verbara.Sdk.Push" Version="2.4.0" />
    <PackageVersion Include="Verbara.Sdk.Resilience" Version="2.4.0" />
    <PackageVersion Include="Verbara.Sdk.OpenTelemetry" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Verbara.Sdk.Pro.EventStore" Version="2.14.1-pro" />
    <PackageVersion Include="Verbara.Sdk.Pro.Analytics" Version="2.14.1-pro" />
    <PackageVersion Include="Verbara.Sdk.Pro.CallAnalytics" Version="2.14.1-pro" />
    <PackageVersion Include="Verbara.Sdk.Pro.Dialer" Version="2.14.1-pro" />
    <PackageVersion Include="Verbara.Sdk.Pro.Dialer.Storage.Postgres" Version="2.14.1-pro" />
    <PackageVersion Include="Verbara.Sdk.Pro.EventStore.Postgres" Version="2.14.1-pro" />
    <PackageVersion Include="Verbara.Sdk.Pro.CallAnalytics.Storage.Postgres" Version="2.14.1-pro" />
    <PackageVersion Include="Verbara.Sdk.Pro.Analytics.Storage.Postgres" Version="2.14.1-pro" />
    <PackageVersion Include="Verbara.Sdk.Pro.Licensing" Version="2.14.1-pro" />
    <PackageVersion Include="Verbara.Sdk.Pro.CsatRunner" Version="2.14.1-pro" />
    <PackageVersion Include="Verbara.Sdk.Pro.AgentAssist" Version="2.14.1-pro" />
    <PackageVersion Include="Verbara.Sdk.Pro.AgentAssist.Storage.Postgres" Version="2.14.1-pro" />
    <PackageVersion Include="Verbara.Sdk.Pro.Routing" Version="2.14.1-pro" />
    <PackageVersion Include="Verbara.Sdk.Pro.Realtime" Version="2.14.1-pro" />
    <PackageVersion Include="Verbara.Sdk.Pro.Realtime.Storage.Postgres" Version="2.14.1-pro" />
    <PackageVersion Include="Verbara.Sdk.Pro.Cluster" Version="2.14.1-pro" />
    <PackageVersion Include="Verbara.Sdk.Pro.Cluster.Storage.Postgres" Version="2.14.1-pro" />
    <PackageVersion Include="Verbara.Sdk.Pro.MultiTenant" Version="2.14.1-pro" />
    <PackageVersion Include="Verbara.Sdk.Pro.Push" Version="2.14.1-pro" />
    <PackageVersion Include="Verbara.Sdk.Pro.Push.SignalR" Version="2.14.1-pro" />
    <PackageVersion Include="Verbara.Sdk.Pro.Storage.Common" Version="2.14.1-pro" />
    <PackageVersion Include="Verbara.Sdk.Pro.OpenTelemetry" Version="2.14.1-pro" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Asp.Versioning.Http" Version="10.2.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.22.0" />
    <PackageVersion Include="Otp.NET" Version="1.4.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="QuestPDF" Version="2026.7.3" />
    <PackageVersion Include="ScottPlot" Version="5.0.55" />
    <PackageVersion Include="MailKit" Version="4.16.0" />
    <PackageVersion Include="MimeKit" Version="4.16.0" />
    <PackageVersion Include="NCrontab" Version="3.4.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.Graph" Version="5.105.0" />
    <PackageVersion Include="Microsoft.Kiota.Abstractions" Version="1.22.2" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="StackExchange.Redis" Version="2.12.14" />
    <!-- Pinned same version as Microsoft.AspNetCore.Authentication.JwtBearer to keep the
         ASP.NET Core 10.x band consistent across Verbara.Platform.Realtime (ADR-0022 Phase A). -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.5" />
    <!-- Client-side SignalR consumed by tests/Verbara.Platform.E2E.Harness (NO-AOT
         walking-skeleton harness for ADR-0022 Phase A.5 exactly-once verification).
         Reflection-based — incompatible with Native AOT, but the harness itself is
         NO-AOT per ADR-0023; deliverables (Api + Realtime images) remain AOT-clean. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.5" />
    <!-- Transitive-pin override (CentralPackageTransitivePinningEnabled=true): SignalR's
         MessagePack protocol pulls MessagePack transitively into Realtime + Realtime.Tests.
         The version it would otherwise resolve (2.5.187) carries CVE-2026-48109 — a HIGH
         (CVSS 8.2) DoS in LZ4Block/LZ4BlockArray decompression of untrusted payloads.
         2.5.301 is the patched release. SignalR does not enable LZ4 by default so real
         exposure is low, but NuGet audit (NU1903) correctly flags the vulnerable version. -->
    <PackageVersion Include="MessagePack" Version="2.5.301" />
    <!-- Transitive-pin override (CentralPackageTransitivePinningEnabled=true): the .NET 10
         OpenAPI stack (Microsoft.AspNetCore.OpenApi 10.0.5) pulls Microsoft.OpenApi 2.0.0
         transitively. 2.0.0 carries GHSA-v5pm-xwqc-g5wc — a HIGH-severity advisory that NuGet
         audit (NU1903) flags as an error. 2.9.0 is the patched release (same major, API-compatible
         floor for AspNetCore.OpenApi). Pre-existing on main; pinned here to unblock the build. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.9.0" />
    <!-- Transitive-pin override (CentralPackageTransitivePinningEnabled=true): System.Security.
         Cryptography.Xml 10.0.7 is pulled transitively across src + test projects and carries four
         HIGH-severity advisories (GHSA-23rf-6693-g89p / GHSA-8q5v-6pqq-x66h / GHSA-cvvh-rhrc-wg4q /
         GHSA-g8r8-53c2-pm3f) that NuGet audit (NU1903) escalates to a build error under TWAE.
         10.0.10 is the latest .NET 10 servicing patch, clearing all four. Advisory drift — published
         after the last green main run (01560e4); pinned here to unblock every Platform build. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.10" />
    <!-- Transitive-pin override (CentralPackageTransitivePinningEnabled=true): Testcontainers
         pulls SSH.NET transitively into the container-backed test projects. 2025.1.0 carries
         GHSA-q939-rpr3-3284 — a HIGH (CVSS 7.1) arbitrary-file-write via server-controlled
         filenames in ScpClient's recursive download. 2026.0.0 is the first patched release.
         Testcontainers 4.13.0 (latest) still depends on 2025.1.0, so upgrading it does not clear
         the advisory — the pin is the only fix. Real exposure is nil: SSH.NET is loaded only for
         Testcontainers' host-port forwarding, which no suite here uses. Advisory drift — published
         2026-08-12, after the last green main run (90eecc7e); every .NET repo went red on it. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.5" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.13.11" />
    <PackageVersion Include="Testcontainers" Version="4.11.0" />
  </ItemGroup>

  <!-- NBomber load test suite (R5.4 S5.1). Consumed only by the opt-in
       tests/Verbara.Platform.LoadTests project, which is NOT part of the
       default slnx and runs exclusively via scripts/load-test.sh. -->
  <ItemGroup>
    <PackageVersion Include="NBomber" Version="6.1.0" />
    <PackageVersion Include="NBomber.Http" Version="6.0.0" />
  </ItemGroup>

  <!-- Auth Hotpath Hardening (AHH) Phase 0 evidence stack. Consumed by the
       opt-in tests/Verbara.Platform.Benchmarks project (BenchmarkDotNet, JIT)
       and tests/Verbara.Platform.Api.Aot.Probe (AOT publish probe for the
       Argon2id candidate library). Neither project ships in the slnx; both
       run exclusively via scripts/profiling/. See
       docs/plans/active/2026-04-27-auth-hotpath-hardening.md Phase 0. -->
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.14.0" />
    <PackageVersion Include="Isopoh.Cryptography.Argon2" Version="2.0.0" />
  </ItemGroup>

</Project>
