<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Cascading, conditional, AI-assisted typification (disposition) domain model, schema bindings, submissions, and store abstractions for Verbara.Platform</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Verbara.Platform.Typification.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Verbara.Platform.Core\Verbara.Platform.Core.csproj" />
    <ProjectReference Include="..\Verbara.Platform.Conversations\Verbara.Platform.Conversations.csproj" />
    <ProjectReference Include="..\Verbara.Platform.Llm\Verbara.Platform.Llm.csproj" />
    <!-- ITypificationCorrectionAuditWriter (audit-trail-integrity-fixes, fix 1) atomically writes
         the correction record and its AuditEntry — needs the Audit domain model. -->
    <ProjectReference Include="..\Verbara.Platform.Audit\Verbara.Platform.Audit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <!-- ILicenseStatus + LicenseFeature: the per-deployment Pro license snapshot the autonomous
         disposition policy gates on (the same abstraction LicenseGateMiddleware reads; ADR-0034). -->
    <PackageReference Include="Verbara.Sdk.Pro.Licensing" />
  </ItemGroup>

</Project>
