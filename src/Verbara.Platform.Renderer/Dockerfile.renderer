FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
ARG CACHEBUST=1
COPY . .
# Renderer has NO Pro dependencies — restore from nuget.org only. Drop the
# maintainer-only `local` source (its host path doesn't exist in the build
# context); the SDK packages resolve from nuget.org (mapped in NuGet.Config).
RUN dotnet nuget remove source local 2>/dev/null || true; \
    dotnet nuget locals all --clear; \
    dotnet publish src/Verbara.Platform.Renderer/Verbara.Platform.Renderer.csproj -c Release -o /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app .
EXPOSE 5010
ENV ASPNETCORE_URLS=http://+:5010
ENTRYPOINT ["dotnet", "Verbara.Platform.Renderer.dll"]
