<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Assembly version flows from the central PackageVersion (Directory.Build.props)
         so /management/system/info + OpenAPI report the real release version. Before
         v2.6.0 this was hardcoded "1.7.0" and the API mis-reported its version for the
         entire v2.x line. -->
    <Version>$(PackageVersion)</Version>
    <Description>ASP.NET Core Minimal API layer for Verbara.Platform — webhook ingestion, agent desktop, admin CRUD, SSE events, SignalR PlatformHub</Description>
    <!-- ADR-0022 Phase D (2026-05-20): Dapper removed cross-repo (SDK + Pro + Platform);
         Platform.Api now publishes Native AOT with 0 IL2026/IL3050/IL207x diagnostics
         (validated 2026-05-20, docs/operations/phase-d-validation/2026-05-19-pilot-aot-delta.md).
         The SignalR Hub was extracted to Verbara.Platform.Realtime in Phase A, so it is no
         longer an AOT blocker here. Analyzers stay ON to keep the host AOT-clean on every
         build; the native single-binary publish is invoked by docker/Dockerfile.api-aot
         (-p:PublishAot=true -r linux-x64), not asserted unconditionally here so that
         `dotnet build/test/run` for local dev + CI keep using the portable JIT path. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- ADR-0022 Phase D: under PublishAot, System.Text.Json sets
         IsReflectionEnabledByDefault=false so there is NO reflection fallback —
         every (de)serialized type MUST be in a source-gen context (ApiJsonContext
         / RealtimeContractsJsonContext). We force the switch off for the regular
         JIT build/test/run too, so dev + the 1,180 Api.Tests surface any missing
         [JsonSerializable] registration as a NotSupportedException instead of
         silently filling the gap via reflection (which masks AOT-only 500s). -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <!-- Intercepts Configure<T>(IConfiguration) + ConfigurationBinder.GetValue<T> with
         AOT-safe generated binders. PublishAot auto-enables this; we set it explicitly so
         the regular `dotnet build` (analyzers on via IsAotCompatible) matches the AOT publish
         and stays free of IL2026/IL3050 config-binding diagnostics. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <IsPackable>false</IsPackable>
    <!-- v1.14.4 (CFG-003 fix) — enables `dotnet user-secrets` for the
         Development environment so devs don't need plaintext credentials in
         appsettings.Development.json. Once a user-secret is set, ASP.NET
         Core's configuration provider chain reads it BEFORE
         appsettings.Development.json so any literal value in that file is
         overridden silently in dev. -->
    <UserSecretsId>verbara-platform-api-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Verbara.Platform.Api.Tests" />
  </ItemGroup>

  <!-- ADR-0022 Phase D: PublishAot does not support runtimeconfig.template.json, so the
       Npgsql legacy-timestamp feature switch is declared as a host config option (emitted
       into runtimeconfig.json for both JIT and AOT publish). Trim="false" keeps the switch
       name string from being trimmed under AOT. Preserves the prior runtimeconfig.template.json. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Npgsql.EnableLegacyTimestampBehavior" Value="true" Trim="false" />
  </ItemGroup>

