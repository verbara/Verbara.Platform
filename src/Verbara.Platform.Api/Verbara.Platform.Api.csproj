    <PackageReference Include="Verbara.Sdk.Pro.AgentAssist.Storage.Postgres" />
    <PackageReference Include="Verbara.Sdk.Pro.Routing" />
    <PackageReference Include="Verbara.Sdk.Pro.Realtime" />
    <PackageReference Include="Verbara.Sdk.Pro.Realtime.Storage.Postgres" />
    <PackageReference Include="Verbara.Sdk.Pro.Cluster" />
    <PackageReference Include="Verbara.Sdk.Pro.Cluster.Storage.Postgres" />
    <PackageReference Include="Verbara.Sdk.Pro.MultiTenant" />
    <PackageReference Include="Verbara.Sdk.Pro.Push" />
    <!-- Verbara.Sdk.Pro.Push.SignalR is kept for the T27 bridges + event types
         (Verbara.Sdk.Pro.Push.SignalR.Bridges, Verbara.Sdk.Pro.Push.SignalR.Events).
         The Hub host + PresenceTracker + PushToHubRelay moved to
         Verbara.Platform.Realtime per ADR-0022, but the bridges still run here
         because they depend on SDK heavyweight types (ICallSessionManager,
         VerbaraServerPool, ClusterTransportBase) that live in Platform.Api. -->
    <PackageReference Include="Verbara.Sdk.Pro.Push.SignalR" />
    <PackageReference Include="Verbara.Sdk.OpenTelemetry" />
    <PackageReference Include="Verbara.Sdk.Pro.OpenTelemetry" />
  </ItemGroup>

</Project>
