    <!-- ADR-0022 Phase A — shared DTOs for /api/v1/internal endpoints consumed by
         Verbara.Platform.Realtime. Contracts project is AOT-clean. -->
    <ProjectReference Include="..\Verbara.Platform.Realtime.Contracts\Verbara.Platform.Realtime.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="BCrypt.Net-Next" />
    <!-- AHH Phase 4: Argon2id replaces BCrypt as the canonical password hash.
         BCrypt.Net-Next stays as a verify-only legacy path so already-hashed
         passwords keep working across the on-login transparent rehash. See
         docs/decisions/0013-password-hash-algorithm-migration.md. -->
    <PackageReference Include="Isopoh.Cryptography.Argon2" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
