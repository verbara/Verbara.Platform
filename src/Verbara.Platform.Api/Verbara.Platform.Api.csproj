<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Version>1.7.0</Version>
    <Description>ASP.NET Core Minimal API layer for Verbara.Platform — webhook ingestion, agent desktop, admin CRUD, SSE events, SignalR PlatformHub</Description>
    <!-- Platform.Api consumes Verbara.Sdk.Pro.Push.SignalR (hub + presence CRDT)
         which depends on Microsoft.AspNetCore.SignalR. SignalR server-side dispatch in
         .NET 10 still relies on reflection that trips the trim/AOT analyzers. Keep the
         analyzers off on this project so warnings-as-errors do not gate the build. -->
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <IsPackable>false</IsPackable>
    <!-- v1.14.4 (CFG-003 fix) — enables `dotnet user-secrets` for the
         Development environment so devs don't need plaintext credentials in
         appsettings.Development.json. Once a user-secret is set, ASP.NET
         Core's configuration provider chain reads it BEFORE
         appsettings.Development.json so any literal value in that file is
         overridden silently in dev. -->
    <UserSecretsId>verbara-platform-api-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Verbara.Platform.Api.Tests" />
  </ItemGroup>

<ItemGroup>
    <ProjectReference Include="..\Verbara.Platform.Core\Verbara.Platform.Core.csproj" />
    <ProjectReference Include="..\Verbara.Platform.Identity\Verbara.Platform.Identity.csproj" />
    <ProjectReference Include="..\Verbara.Platform.Identity.Redis\Verbara.Platform.Identity.Redis.csproj" />
    <ProjectReference Include="..\Verbara.Platform.Conversations\Verbara.Platform.Conversations.csproj" />
