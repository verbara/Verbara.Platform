    <ProjectReference Include="..\Verbara.Platform.Channels.WhatsApp\Verbara.Platform.Channels.WhatsApp.csproj" />
    <ProjectReference Include="..\Verbara.Platform.Channels.Sms\Verbara.Platform.Channels.Sms.csproj" />
    <ProjectReference Include="..\Verbara.Platform.Channels.WebChat\Verbara.Platform.Channels.WebChat.csproj" />
