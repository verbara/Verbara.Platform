    <ProjectReference Include="..\Verbara.Platform.Channels.Messenger\Verbara.Platform.Channels.Messenger.csproj" />
    <ProjectReference Include="..\Verbara.Platform.Channels.Instagram\Verbara.Platform.Channels.Instagram.csproj" />
    <ProjectReference Include="..\Verbara.Platform.Channels.Telegram\Verbara.Platform.Channels.Telegram.csproj" />
    <ProjectReference Include="..\Verbara.Platform.Channels.Twitter\Verbara.Platform.Channels.Twitter.csproj" />
    <ProjectReference Include="..\Verbara.Platform.Channels.Video\Verbara.Platform.Channels.Video.csproj" />
    <ProjectReference Include="..\Verbara.Platform.Channels.Rcs\Verbara.Platform.Channels.Rcs.csproj" />
    <ProjectReference Include="..\Verbara.Platform.Routing.Inbound\Verbara.Platform.Routing.Inbound.csproj" />
    <ProjectReference Include="..\Verbara.Platform.Switchboard\Verbara.Platform.Switchboard.csproj" />
    <ProjectReference Include="..\Verbara.Platform.Flows\Verbara.Platform.Flows.csproj" />
    <ProjectReference Include="..\Verbara.Platform.Bot\Verbara.Platform.Bot.csproj" />
    <ProjectReference Include="..\Verbara.Platform.KnowledgeBase\Verbara.Platform.KnowledgeBase.csproj" />
    <ProjectReference Include="..\Verbara.Platform.Automation\Verbara.Platform.Automation.csproj" />
    <ProjectReference Include="..\Verbara.Platform.Surveys\Verbara.Platform.Surveys.csproj" />
