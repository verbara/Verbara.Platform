<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Version>$(PackageVersion)</Version>
    <Description>Email sending and Microsoft 365 Graph API microservice for Verbara.Platform</Description>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates\*.html" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Verbara.Platform.Mail.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Verbara.Platform.Core\Verbara.Platform.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.Graph" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Verbara.Sdk.Data.Npgsql" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Verbara.Sdk.Resilience" />
  </ItemGroup>

</Project>
