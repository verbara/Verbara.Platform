# Database
POSTGRES_PASSWORD=change_me_in_production
ConnectionStrings__Platform=Host=postgres;Database=platform;Username=platform;Password=change_me_in_production

# S3 Recording Storage (optional — enable with: docker compose --profile s3 up)
S3_BUCKET=recordings
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true

# CORS (comma-separated origins)
CORS_ORIGINS=https://your-domain.com

# Public address of the console, as users open it. Password-reset links and the
# OIDC redirect_uri are built from it, never from a request's Host header. Unset,
# the API uses CORS_ORIGINS when that names exactly one origin, as above; when it
# names several, set this, or no reset email is sent and OIDC sign-in is refused.
# Platform__PublicBaseUrl=https://your-domain.com

# Cluster Redis (optional — enable with: docker compose --profile cluster up)
Redis__ConnectionString=redis:6379
