# Settings for docker/docker-compose.production.yml. Copy this file to docker/.env.production and fill in every
# empty value below: each service reads this file as given, and a service left without a setting it needs refuses
# to start and restarts in a loop, with the setting named in its log. Generate each secret on its own, for example
# with `openssl rand -hex 32`, and never reuse one between deployments.

# Database
# Postgres sets its password from POSTGRES_PASSWORD on the first start, with an empty data volume; changing it later
# does not change the database's password.
POSTGRES_PASSWORD=change_me_in_production
# The services read the password from PGPASSWORD, as given; keep it equal to POSTGRES_PASSWORD and keep
# Password= out of the connection string, where a ; a quote or a space in the password would break it.
PGPASSWORD=change_me_in_production
ConnectionStrings__Postgres=Host=postgres;Database=verbara;Username=platform;Maximum Pool Size=10

# Service key: the Api, realtime, renderer and mail services check it on each other's calls. Required: the Api
# does not start in Production with it empty or left at the built-in default.
#   openssl rand -hex 32
Services__ServiceKey=

# Asterisk manager interface (AMI). The Api connects to Asterisk at Asterisk__Ami__Hostname (localhost when unset)
# and does not start in Production without a user and password for it, nor with admin/admin. Use a manager
# account from your Asterisk's manager.conf.
# Asterisk__Ami__Hostname=pbx.your-domain.com
Asterisk__Ami__Username=
Asterisk__Ami__Password=

# CSAT email replies. The Api signs the reply address of each CSAT email with this secret, and the mail service
# checks replies with it, so both settings hold the same value. Required: the mail service does not start without
# Imap__TokenSigningSecret, even with the reply mailbox (Imap__Enabled) off, and the Api does not start with
# Csat__Email__TokenSigningSecret present but empty.
#   openssl rand -hex 32
Imap__TokenSigningSecret=
Csat__Email__TokenSigningSecret=

# CSAT reply mailbox (optional, off unless Imap__Enabled=true). The mail service reads the replies to CSAT emails
# from this IMAP mailbox and sends each rating to the Api. With it on, the mail service does not start without the
# address of the Api and the mailbox's tenant, host, user and password; uncomment and fill them together.
# Imap__Enabled=true
# The Api as the mail service reaches it inside this stack: the platform-api service on port 5000.
# CsatCapture__ApiBaseAddress=http://platform-api:5000
# The key sent with each rating. Leave it unset: the mail service then sends Services__ServiceKey, the key the Api
# checks. Set it only to the Api's Services__ServiceKey when the two services read different files.
# CsatCapture__ServiceKey=
# The tenant the replies belong to (the customer tenant's id), and the mailbox that receives them.
# Imap__Mailboxes__0__TenantId=
# Imap__Mailboxes__0__Host=imap.your-domain.com
# Imap__Mailboxes__0__Port=993
# Imap__Mailboxes__0__UseTls=true
# Imap__Mailboxes__0__Username=
# Imap__Mailboxes__0__Password=
# The folder the replies land in: INBOX when unset, or another folder's full name as the mail server lists it, with
# its own separator (INBOX.CsatReplies, INBOX/CsatReplies or CsatReplies). A folder the server does not have is
# logged as an error on every poll and no reply is read.
# Imap__Mailboxes__0__Folder=INBOX

# S3 Recording Storage (optional — enable with: docker compose --profile s3 up)
S3_BUCKET=recordings
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true

# CORS (comma-separated origins). Required: the Api does not start in Production without it, or with *.
CORS_ORIGINS=https://your-domain.com

# Public address of the console, as users open it. Password-reset links and the
# OIDC redirect_uri are built from it, never from a request's Host header. Unset,
# the API uses CORS_ORIGINS when that names exactly one origin, as above; when it
# names several, set this, or no reset email is sent and OIDC sign-in is refused.
# Platform__PublicBaseUrl=https://your-domain.com

# Cluster Redis (optional — enable with: docker compose --profile cluster up)
Redis__ConnectionString=redis:6379
