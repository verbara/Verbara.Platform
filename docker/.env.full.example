# Postgres
POSTGRES_PASSWORD=platform_secret

# Asterisk AMI/ARI
AMI_PASSWORD=platform_secret
ARI_PASSWORD=asterisk_ari_secret

# Web frontend
CORS_ORIGINS=http://localhost
# Public address of the console, as users open it (password-reset links, OIDC
# redirect_uri). Unset, the API uses CORS_ORIGINS when that names exactly one origin.
# PUBLIC_BASE_URL=http://localhost

# S3 (uncomment + run with: docker compose --profile s3 up)
# S3_BUCKET=recordings
# S3_ENDPOINT=http://minio:9000
