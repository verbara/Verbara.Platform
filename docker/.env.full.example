# Settings for docker/docker-compose.full.yml. Copy this file to docker/.env, where compose reads it when started
# with `docker compose -f docker/docker-compose.full.yml up -d`, and fill in every empty value below: compose does not
# start the stack while one is empty.

# Postgres
POSTGRES_PASSWORD=platform_secret

# Service key: the Api, realtime, renderer and mail services check it on each other's calls. Required: the Api
# runs in Production here and does not start with it empty or left at the built-in default.
#   openssl rand -hex 32
SERVICE_KEY=

# Asterisk AMI/ARI
AMI_PASSWORD=platform_secret
ARI_PASSWORD=asterisk_ari_secret

# Web frontend
CORS_ORIGINS=http://localhost
# Public address of the console, as users open it (password-reset links, OIDC
# redirect_uri). Unset, the API uses CORS_ORIGINS when that names exactly one origin.
# PUBLIC_BASE_URL=http://localhost

# S3 (uncomment + run with: docker compose --profile s3 up)
# S3_BUCKET=recordings
# S3_ENDPOINT=http://minio:9000
