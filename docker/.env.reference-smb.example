# ════════════════════════════════════════════════════════════════════════════
# .env.reference-smb — Verbara Platform SMB reference deployment
# ════════════════════════════════════════════════════════════════════════════
#
# Copy this file to `.env.reference-smb` and edit BEFORE running
# `docker compose -f docker/docker-compose.reference-smb.yml \
#                 --env-file docker/.env.reference-smb up -d --wait`.
#
# The reference compose ALSO requires `scripts/quickstart-smb.sh` to be run
# once before the first `compose up` — it validates that all SIP/RTP ports
# are free, detects NAT, and prints the firewall rules you need to add.
#
# Sections:
#   1. Release images (which Platform version to pull)
#   2. Capacity tier (Lite / Standard / Plus)
#   3. Network — public IP, EXTERNAL_IP, SIP/RTP port range
#   4. Database (Postgres)
#   5. Secrets — service key + CSAT reply secret, customer tenant, day zone
#   6. Voice/SIP — Asterisk AMI/ARI passwords
#   7. Email — SMTP outbound + CSAT reply mailbox (IMAP poller)
#   8. Redis (always on) + optional Microsoft Graph, Coturn
#   9. Licensing (Pro license — leave commented for community/OSS path)
#
# After editing, validate with:
#   docker compose -f docker/docker-compose.reference-smb.yml \
#                  --env-file docker/.env.reference-smb config
#
# ════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────────
# 1. RELEASE IMAGES
# ──────────────────────────────────────────────────────────────────────────
# The API+Web pair this release of the repository was verified with. MUST
# equal the compose defaults (`scripts/check-smb-pins.py` checks it in CI).
# Verify the signatures BEFORE pulling (see docker/verbara-verify-image.sh).
#   cosign verify --key docker/cosign.pub \
#     ghcr.io/verbara/platform/api:v2.33.1
#   cosign verify --key docker/cosign.pub \
#     ghcr.io/verbara/platform/web:v3.27.1-web

PLATFORM_API_TAG=v2.33.1
PLATFORM_WEB_TAG=v3.27.1-web
ASTERISK_VERSION=22

# ──────────────────────────────────────────────────────────────────────────
# 2. CAPACITY TIER
# ──────────────────────────────────────────────────────────────────────────
# Defaults below = SMB Standard tier (8 vCPU / 32 GB → 150 concurrent calls).
# See docs/manuales/smb/capacity-reference.md for the full matrix.
#
#   ┌──────────────┬────────────┬────────────┬─────────────────────────┐
#   │ Tier         │ vCPU / RAM │ Calls/Agts │ RTP_PORT_END to set     │
#   ├──────────────┼────────────┼────────────┼─────────────────────────┤
#   │ SMB Lite     │ 4 / 16 GB  │  50 /  50  │ 20200 (default)         │
#   │ SMB Standard │ 8 / 32 GB  │ 150 / 150  │ 20400                   │
#   │ SMB Plus     │ 16 / 64 GB │ 300 / 300  │ 20600                   │
#   └──────────────┴────────────┴────────────┴─────────────────────────┘
#
# Increase RTP_PORT_END by 2× the extra calls you need beyond default 100.

# ──────────────────────────────────────────────────────────────────────────
# 3. NETWORK
# ──────────────────────────────────────────────────────────────────────────
# EXTERNAL_IP — your server's PUBLIC IP. Asterisk uses this to rewrite the
# SDP body in SIP responses so the remote peer sends RTP back to a routable
# address. REQUIRED if your server is behind NAT (almost all on-prem
# deployments) — leave EMPTY only when the server's NIC has a direct
# public IP (e.g. a cloud VM without a NAT gateway).
#
# `scripts/quickstart-smb.sh` auto-detects which scenario applies and
# prints the value to use here. The 4 scenarios:
#   A) Direct public IP on the NIC (cloud VM, bare-metal w/ public IP)
#       → leave EXTERNAL_IP empty
#   B) Cloud VM w/ private NIC + cloud-managed public IP (AWS ENI, Azure,
#       GCP, Hetzner with floating IP) → set EXTERNAL_IP = your public IP
#   C) On-prem behind a router with DMZ or port-forward → set EXTERNAL_IP
#       = your WAN IP (visible at https://api.ipify.org from this server)
#   D) CGNAT (ISP NATs you behind 100.64.0.0/10) → SIP inbound won't work;
#       use outbound-only trunk OR get a public IP from the ISP
#
EXTERNAL_IP=

# ── SIP signalling ports ──────────────────────────────────────────────────
# These bind on the HOST (Asterisk uses network_mode: host). The host MUST
# NOT have any other process using these ports (no other PBX).
SIP_UDP_PORT=5060
SIP_TCP_PORT=5060
SIP_TLS_PORT=5061
# 4569 IAX2 — legacy, only enable if you actually have IAX2 trunks.
# EXPOSE_IAX=false

# ── ARI (Asterisk REST + WebRTC WSS) ──────────────────────────────────────
ARI_HTTP_PORT=8088
ARI_WSS_PORT=8089
# 8180 WS plain — used internally between the Web's WebRTC client and
# Asterisk when TLS is disabled. NOT exposed for production; for production
# use the WSS port (8089).

# ── AMI (management/event-stream interface) ───────────────────────────────
# Recommended: restrict 5038 to specific source IPs at the host firewall —
# this is the management/control plane port.
AMI_PORT=5038

# ── RTP range (each call uses 2 UDP ports = RTP + RTCP) ───────────────────
# 200-port default = 100 simultaneous calls. Bump end up to 20600 for 300.
RTP_PORT_START=20000
RTP_PORT_END=20200

# ── Web frontend ──────────────────────────────────────────────────────────
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
# Set when terminating TLS at the Web's nginx (not the host reverse-proxy):
# WEB_TLS_CERT=/etc/verbara/tls/fullchain.pem
# WEB_TLS_KEY=/etc/verbara/tls/privkey.pem

# ── Platform.Api ──────────────────────────────────────────────────────────
API_PORT=5000

# ── Optional: Postgres external port (LOOPBACK ONLY by default) ───────────
# Asterisk-on-host-network connects via 127.0.0.1:5432. NOT exposed on the
# LAN. To allow LAN admin access, edit the compose file directly.
PG_PORT=5432

# ── Optional: MinIO (only with --profile s3) ──────────────────────────────
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── CORS — origins allowed to call the API. Comma-separated. ──────────────
# In production set to the actual HTTPS origin of your Web instance.
CORS_ORIGINS=http://localhost,https://localhost

# ── Public address of the console, as users open it. ──────────────────────
# Password-reset links and the OIDC redirect_uri are built from it, never
# from a request's Host header. Unset, the API uses CORS_ORIGINS when that
# names exactly one origin; with the two-origin default above it MUST be
# set, or no reset email is sent and OIDC sign-in is refused. Set it to the
# address your users type (e.g. https://contact.example.com, or
# http://192.168.1.50 when they open the console by LAN IP). The OIDC
# redirect URI to register with your identity provider is
# <this address>/api/auth/oidc/callback.
PUBLIC_BASE_URL=http://localhost

# ──────────────────────────────────────────────────────────────────────────
# 4. DATABASE
# ──────────────────────────────────────────────────────────────────────────
POSTGRES_DB=verbara
POSTGRES_USER=platform
# Set a strong password (32+ chars random recommended).
#   openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_AT_LEAST_32_CHARS

# Connection pool tuning. SMB Standard defaults below; bump max for Plus.
PG_POOL_MIN=2
PG_POOL_MAX=10

# Postgres server settings (forwarded to `postgres -c`).
PG_MAX_CONNECTIONS=200
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=2GB

# ──────────────────────────────────────────────────────────────────────────
# 5. AUTH SECRETS — generate fresh strings, never reuse the example values
# ──────────────────────────────────────────────────────────────────────────
# No JWT signing key to set: the API generates its signing keys and keeps
# them in Redis (section 8), where Realtime reads them too.

# Service-to-service key (Platform.Api ↔ Realtime ↔ Renderer ↔ Mail). 32+
# chars. The mail service also uses it to hand CSAT replies to the API.
#   openssl rand -base64 32
SERVICE_KEY=CHANGE_ME_32_CHARS_OF_BASE64_RANDOM

# CSAT reply token secret — the API signs the csat+<token>@ Reply-To of
# every CSAT email with it and the mail service verifies replies with it.
# Required even if you never enable the IMAP poller (section 7). 32+ chars.
#   openssl rand -base64 32
CSAT_REPLY_TOKEN_SECRET=CHANGE_ME_32_CHARS_OF_BASE64_RANDOM

# ── Customer tenant ───────────────────────────────────────────────────────
# REQUIRED. The customer tenant id (a lowercase slug, e.g. `acme`) you will
# type in the setup wizard. The API serves this tenant's agents, queues and
# trunks to Asterisk; it is also the default tenant of the CSAT mailbox.
# It cannot be left empty (the compose refuses to start): an empty value
# would name a tenant "" rather than fall back to a default.
CUSTOMER_TENANT_ID=

# ── Licensed-agent day zone ───────────────────────────────────────────────
# IANA time zone (e.g. America/Bogota) that cuts the licensed-agent
# metering day. Set it ONCE, before the first start: the first start of
# v2.27.0 or later fixes it in the database, and a later change stops the
# daily close until it is put back. Unset = UTC.
LICENSE_DAY_ZONE=UTC

# ──────────────────────────────────────────────────────────────────────────
# 6. VOICE / SIP — Asterisk AMI + ARI passwords
# ──────────────────────────────────────────────────────────────────────────
# Strong random passwords. Asterisk's manager.conf and ari.conf are
# rewritten by the entrypoint to use these at boot.
AMI_PASSWORD=CHANGE_ME_STRONG_AMI_PASSWORD
ARI_PASSWORD=CHANGE_ME_STRONG_ARI_PASSWORD

# ──────────────────────────────────────────────────────────────────────────
# 7. EMAIL — SMTP outbound + CSAT reply mailbox (IMAP)
# ──────────────────────────────────────────────────────────────────────────
# Outbound SMTP. Examples below use Gmail App Password and Microsoft 365.
# For Gmail OAuth see docs/manuales/smb/05-canal-email.md.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@your-domain.com
SMTP_FROM_NAME=Soporte Verbara

# IMAP = the CSAT reply poller of the mail service, NOT the Email channel's
# inbound. CSAT emails go out with Reply-To csat+<token>@CSAT_REPLY_TO_DOMAIN;
# the poller drains the mailbox below, matches each reply to its survey and
# hands the rating to the API. Route csat+<anything>@CSAT_REPLY_TO_DOMAIN to
# this mailbox (plus-addressing or a catch-all), or replies are never seen.
# Off until IMAP_ENABLED=true.
IMAP_ENABLED=false
CSAT_REPLY_TO_DOMAIN=csat.verbara.local
# Tenant the mailbox's replies belong to: the customer tenant id created in
# the setup wizard. Unset = CUSTOMER_TENANT_ID.
# IMAP_TENANT_ID=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USE_TLS=true
IMAP_USER=
IMAP_PASSWORD=

# ──────────────────────────────────────────────────────────────────────────
# 8. REDIS + OPTIONAL — Microsoft Graph, Coturn
# ──────────────────────────────────────────────────────────────────────────
# Redis always runs: the API keeps its JWT signing keys there and Realtime
# validates the console's tokens against them; live updates also travel
# through it. Optional password: when set, Redis starts with --requirepass
# and every connection string gets `,password=…` automatically.
# REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_MAXMEMORY=256mb

# Microsoft Graph OAuth (only if you send mail via M365 instead of SMTP).
# MS_CLIENT_ID=
# MS_TENANT_ID=common

# Coturn (--profile coturn). Required for WebRTC agents behind strict NAT.
# See docker-compose.coturn.yml for the full setup + firewall rules.
# COTURN_USER=verbara-turn
# COTURN_PASSWORD=CHANGE_ME_STRONG_TURN_PASSWORD
# COTURN_REALM=verbara.local
# COTURN_LISTEN_PORT=3478
# COTURN_TLS_PORT=5349
# COTURN_RELAY_MIN=49152
# COTURN_RELAY_MAX=65535

# ──────────────────────────────────────────────────────────────────────────
# 9. LICENSING (model updated 2026-05-17 for Pro v2.4.0-pro)
# ──────────────────────────────────────────────────────────────────────────
# Point LICENSE_PATH at your signed .lic file (host path) to enable Pro
# features (Dialer / EventStore / AgentAssist / Cluster / MultiTenant / etc.)
# AND uncomment the licence bind-mount in the platform-api `volumes:` of the
# compose — it mounts the file at /etc/verbara/license.lic, where the API
# reads it.
#
# No licence mounted = community / OSS mode — Pro endpoints respond
# with HTTP 402 PaymentRequired + RFC 9457 ProblemDetails carrying actionable
# `trial_url`, `upgrade_url`, and `contact_sales_url` extension members.
# The core (non-Pro) API surface remains fully functional.
#
# Acquire a free Tier 0.5 developer license (≤5 agents · ≤1 node · 30-day
# rolling, no credit card) at:
#   https://verbara.io/developer-license
#
# When LICENSE_PATH is set, also fill IMAGE_DIGEST with the sha256 digest of
# the api image you pulled (defense layer C per Pro/ADR-0011).
LICENSE_PATH=
IMAGE_DIGEST=

# ──────────────────────────────────────────────────────────────────────────
# 10. RESOURCE LIMITS — keep defaults unless your hardware tier changes
# ──────────────────────────────────────────────────────────────────────────
ASTERISK_CPU_LIMIT=4.0
ASTERISK_MEM_LIMIT=4G

PLATFORM_API_CPU_LIMIT=2.0
PLATFORM_API_MEM_LIMIT=1500M

WEB_CPU_LIMIT=0.5
WEB_MEM_LIMIT=256M

POSTGRES_CPU_LIMIT=2.0
POSTGRES_MEM_LIMIT=2G

REDIS_CPU_LIMIT=0.5
REDIS_MEM_LIMIT=512M

# ──────────────────────────────────────────────────────────────────────────
# 11. STORAGE — where recordings live on disk
# ──────────────────────────────────────────────────────────────────────────
# Internal container path. Override only if you mount an external disk
# (e.g. NFS / SAN) into the recordings volume — typically not needed.
RECORDINGS_PATH=/recordings
